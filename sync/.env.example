# Copy this file to .env (locally) and fill in real values.
# In GitHub Actions, set these as repo secrets instead — see README.md.

# The folder ID from the Drive URL:
# https://drive.google.com/drive/folders/1y3qv2wvSBCGJPjCXHmnXnsxN8teLOjz8
#                                          ^ this part
DRIVE_ROOT_FOLDER_ID=1y3qv2wvSBCGJPjCXHmnXnsxN8teLOjz8

# Paste the full service account JSON key as one line, OR leave this unset
# and instead set GOOGLE_APPLICATION_CREDENTIALS to a file path.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional — defaults to ../site/data/manifest.json
OUTPUT_PATH=
